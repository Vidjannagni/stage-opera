# Copier ce fichier en `.env` et adapter les valeurs.

# Clé secrète Flask (sessions, CSRF).
# OBLIGATOIRE en production : l'application refuse de démarrer si elle vaut
# encore « dev-change-me ». En générer une avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez-cette-valeur

# Environnement : dev | prod | test
FLASK_ENV=dev

# Base de données. Par défaut : SQLite locale (instance/rentimmo.sqlite3).
# En production, l'hébergeur fournit cette variable ; les URL en postgres://
# sont normalisées automatiquement.
# DATABASE_URL=postgresql://user:password@host:5432/rentimmo

# ── Mise en ligne uniquement (cf. docs/deploiement.md) ──────────────────────
# Réserve la création de compte aux porteurs du code. Sans cette variable,
# l'inscription est ouverte à quiconque connaît l'adresse.
# CODE_INSCRIPTION=une-phrase-que-vous-seuls-connaissez

# Crée le jeu de démonstration au démarrage (offres sans accès shell).
# JEU_DE_DEMO=1
